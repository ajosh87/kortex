# Which LLM answers: provider:model (openrouter, anthropic, groq, openai, bedrock_converse)
MODEL=openrouter:openai/gpt-oss-120b
# OpenRouter only: backup models tried in order if the main model errors or is rate-limited
MODEL_FALLBACKS=openai/gpt-oss-120b

# The key for the provider in MODEL (only that one is needed)
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# Public deployments: visitors must paste their own API key in the sidebar; the keys above are never used for
# chats (and Bedrock, which would use the server's AWS credentials, is not offered). Explore, Memory and Data
# work without a key.
REQUIRE_USER_KEY=false
# With REQUIRE_USER_KEY: questions per browser session that run on the server's key for MODEL (default model only),
# so visitors can try the chat first. 0 turns it off. Put a credit limit on that key at the provider as the hard cap.
DEMO_QUESTIONS=5

# FalkorDB (defaults: localhost:6379, no password). Set these for FalkorDB Cloud.
FALKORDB_HOST=
FALKORDB_PORT=
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
# true if the instance requires TLS connections
FALKORDB_TLS=false
